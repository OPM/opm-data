--
-- SPE-2 CARTESIAN SINGLE-WELL DRAWDOWN (GRADED-XY MESH)
-- A Three-Phase Radial Coning Study
--
-- Cartesian re-gridding of the Second SPE Comparative Solution Project
--   H.G. Weinstein, J.E. Chappelear, J.S. Nolen, "Second Comparative
--   Solution Project: A Three-Phase Coning Study," JPT 38(3): 345-353,
--   March 1986.  SPE-10489-PA.
-- Parent radial deck: data/spe2/SPE2.DATA
--
-- What is carried over unchanged from the parent:
--   * the 15 vertical layers and their Table-2 thickness, kx, kz (kz/kx = 0.1)
--     and reference porosity (the latter as the layer mean in the
--     heterogeneous variant),
--   * PERMY = PERMX (the parent deck's COPY behaviour),
--   * the layer 7 + 8 completion and its Table-3 kh, skin and 0.5 ft
--     wellbore diameter,
--   * all fluid data (SWOF, SGOF, PVTO, PVDG, PVTW, DENSITY, ROCK, STONE1),
--   * the contacts (GOC 9035 ft, WOC 9209 ft), the 3600 psia datum at the
--     GOC, the 9000 ft formation top and the 9110 ft BHP reference depth.
--
-- What changes:
--   * GRID.  The Table-3 radial block boundaries
--       0.25, 2.00, 4.32, 9.33, 20.17, 43.56, 94.11, 203.32, 439.24,
--       948.92, 2050.00 ft
--     are mirrored about the well axis to give x- and y-face positions at
--     the same distances on either side.  The mesh is therefore a square
--     4100 x 4100 ft cross section -- 2050 ft from the well centre to each
--     of the four edges -- discretised as 21 x 21 x 15 = 6615 blocks whose
--     plan size grows logarithmically away from the centre.  The central
--     column (I,J) = (11,11) is exactly the 0.5 ft wellbore footprint.
--   * SCHEDULE.  The four-period coning schedule is replaced by a single
--     fixed 400 STB/D oil rate held for the full 900 days, so the well
--     produces a clean, continuously declining pressure transient.  The
--     Table-3 3000 psi minimum BHFP is retained only as a safety limit.
--   * Report times are graded (logarithmic over the first day, then linear)
--     for semilog / log-log well-test diagnostics.
--   * PORO is layer-uniform at the Table-2 values; the sibling deck
--     SPE-2-cartesian-anis.DATA carries the heterogeneous realisation.
-- =====================================================================

RUNSPEC
-- ---------------------------------------------------------------------

TITLE
   SPE-2 CARTESIAN DRAWDOWN - UNIFORM POROSITY

-- Mirrored radial grading: 10 rings + well column + 10 rings in each of x
-- and y, over the 15 Table-2 layers.
DIMENS
   21 21 15 /

OIL
WATER
GAS
-- Live oil with dissolved gas (black oil); no vaporized oil in SPE-2.
DISGAS

FIELD

START
   1 'JAN' 1982 /

WELLDIMS
-- 1 well, completed in 2 layers, 1 group, 1 well/group.
   1 2 1 1 /

TABDIMS
-- 1 sat-fn region, 1 PVT region; node counts sized for Tables 4 and 5.
   1 1 20 30 1 30 /

EQLDIMS
-- 1 equilibration region; raise the depth-node count for RSVD/initialisation.
   1 100 20 1 20 /

UNIFOUT

GRID
-- ---------------------------------------------------------------------
INIT

-- Column widths (ft), -x edge -> +x edge.  Reversed Table-3 ring widths,
-- the 2*rw = 0.5 ft well cell, then the ring widths again; they sum to
-- 2 * 2050 = 4100 ft.
DXV
   1101.08 509.68 235.92 109.21 50.55 23.39 10.84
   5.01 2.32 1.75 0.5 1.75 2.32 5.01
   10.84 23.39 50.55 109.21 235.92 509.68 1101.08 /

-- Identical grading in y: the cross section is square about the well.
DYV
   1101.08 509.68 235.92 109.21 50.55 23.39 10.84
   5.01 2.32 1.75 0.5 1.75 2.32 5.01
   10.84 23.39 50.55 109.21 235.92 509.68 1101.08 /

-- Layer thicknesses (ft), top -> bottom, one value per layer (Table 2).
DZV
   20 15 26 15 16 14 8 8 18 12 19 18 20 50 100 /

-- Depth to top of formation = 9000 ft (Table 3), flat over the 21x21 plan.
TOPS
   441*9000 /

-- Horizontal permeability kx (md) by layer, Table 2.
PERMX
   441*35   441*47.5   441*148   441*202   441*90
   441*418.5   441*775   441*60   441*682   441*472
   441*125   441*300   441*137.5   441*191   441*350 /

-- ky = kx, carrying over the parent deck's COPY behaviour: the Table-2 Kx
-- column is the permeability in both horizontal directions.
COPY
   PERMX PERMY /
/

-- Vertical permeability kz (md) by layer, Table 2 (kz/kx = 0.1).
PERMZ
   441*3.5   441*4.75   441*14.8   441*20.2   441*9
   441*41.85   441*77.5   441*6   441*68.2   441*47.2
   441*12.5   441*30   441*13.75   441*19.1   441*35 /

-- Porosity at reference pressure 3600 psi, uniform per layer (Table 2).
PORO
   441*0.087   441*0.097   441*0.111   441*0.16   441*0.13
   441*0.17   441*0.17   441*0.08   441*0.14   441*0.13
   441*0.12   441*0.105   441*0.12   441*0.116   441*0.157 /

PROPS
-- ---------------------------------------------------------------------

-- Three-phase oil relative permeability by Stone's first method, as in the
-- parent radial deck.
STONE1

-- Water/oil saturation functions (Table 4): Sw, krw, krow, Pcow(psi).
SWOF
   0.22   0.00     1.0000   7.0
   0.30   0.07     0.4000   4.0
   0.40   0.15     0.1250   3.0
   0.50   0.24     0.0649   2.5
   0.60   0.33     0.0048   2.0
   0.80   0.65     0.0000   1.0
   0.90   0.83     0.0000   0.5
   1.00   1.00     0.0000   0.0 /

-- Gas/oil saturation functions (Table 4): Sg, krg, krog, Pcog(psi).
SGOF
   0.00   0.0000   1.00    0.0
   0.04   0.0000   0.60    0.2
   0.10   0.0220   0.33    0.5
   0.20   0.1000   0.10    1.0
   0.30   0.2400   0.02    1.5
   0.40   0.3400   0.00    2.0
   0.50   0.4200   0.00    2.5
   0.60   0.5000   0.00    3.0
   0.70   0.8125   0.00    3.5
   0.78   1.0000   0.00    3.9 /

-- Live-oil PVT (Table 5). Saturated branch: Rs(Mscf/STB) P(psia) Bo(RB/STB)
-- muo(cp), each node carrying one undersaturated point at 6000 psia built
-- from co = 1e-5 psi^-1 (Table 3) with constant undersaturated viscosity.
PVTO
   0.165   400    1.0120   1.17
           6000   0.95533  1.17 /
   0.335   800    1.0255   1.14
           6000   0.97217  1.14 /
   0.500   1200   1.0380   1.11
           6000   0.98818  1.11 /
   0.665   1600   1.0510   1.08
           6000   1.00476  1.08 /
   0.828   2000   1.0630   1.06
           6000   1.02048  1.06 /
   0.985   2400   1.0750   1.03
           6000   1.03630  1.03 /
   1.130   2800   1.0870   1.00
           6000   1.05222  1.00 /
   1.270   3200   1.0985   0.98
           6000   1.06774  0.98 /
   1.390   3600   1.1100   0.95
           6000   1.08336  0.95 /
   1.500   4000   1.1200   0.94
           6000   1.09760  0.94 /
   1.600   4400   1.1300   0.92
           6000   1.11192  0.92 /
   1.676   4800   1.1400   0.91
           6000   1.12632  0.91 /
   1.750   5200   1.1480   0.90
           6000   1.13882  0.90 /
   1.810   5600   1.1550   0.89
           6000   1.15038  0.89 /
/

-- Dry-gas PVT (Table 5): P(psia) Bg(RB/Mscf) mug(cp).
PVDG
   400    5.90   0.0130
   800    2.95   0.0135
   1200   1.96   0.0140
   1600   1.47   0.0145
   2000   1.18   0.0150
   2400   0.98   0.0155
   2800   0.84   0.0160
   3200   0.74   0.0165
   3600   0.65   0.0170
   4000   0.59   0.0175
   4400   0.54   0.0180
   4800   0.49   0.0185
   5200   0.45   0.0190
   5600   0.42   0.0195 /

-- Water PVT referenced at 3600 psi (Table 5): Bw = 1.00341 RB/STB,
-- Cw = 3e-6 psi^-1, muw = 0.96 cp, zero viscosibility.
PVTW
   3600   1.00341   3.0E-6   0.96   0.0 /

-- Surface densities (lbm/cu ft), Table 3: oil, water, gas.
DENSITY
   45.0   63.02   0.0702 /

-- Rock: reference pressure 3600 psi, pore compressibility 4e-6 psi^-1 (Table 3).
ROCK
   3600   4.0E-6 /

SOLUTION
-- ---------------------------------------------------------------------

-- Capillary/gravity equilibrium: 3600 psia at the GOC (9035 ft); WOC at
-- 9209 ft; reference Pc = 0 at each contact (Statement of the Problem).
EQUIL
--  datum  Pdatum  OWC    Pcow@OWC  GOC    Pcog@GOC  Rs(table) Rv  N
    9035   3600    9209   0.0       9035   0.0       1         0   0 /

-- Initial solution GOR constant through the oil column at the bubble-point
-- value for 3600 psi (1.390 Mscf/STB).
RSVD
   9000   1.390
   9359   1.390 /

-- Restart output at every report step, for the EDA/PINN state caches.
RPTRST
   BASIC=2 /

SUMMARY
-- ---------------------------------------------------------------------
-- Well-test observables for the drawdown analysis.
WBHP
/
WOPR
/
WWPR
/
WGPR
/
WWCT
/
WGOR
/
-- Well-block and 9-block averaged pressures (Horner / MDH reference levels).
WBP
/
WBP9
/
-- Block pressures along the well-to-corner diagonal in the two perforated
-- layers, i.e. the (I,J) = (11,11) .. (21,21) ray sampled in the drainage layers.
BPR
   11 11 7 /
   12 12 7 /
   13 13 7 /
   14 14 7 /
   15 15 7 /
   16 16 7 /
   17 17 7 /
   18 18 7 /
   19 19 7 /
   20 20 7 /
   21 21 7 /
   11 11 8 /
   12 12 8 /
   13 13 8 /
   14 14 8 /
   15 15 8 /
   16 16 8 /
   17 17 8 /
   18 18 8 /
   19 19 8 /
   20 20 8 /
   21 21 8 /
/
-- Field averages and fluids in place.
FPR
FOIP
FWIP
FGIP

SCHEDULE
-- ---------------------------------------------------------------------

-- Central producer in column (I,J) = (11,11); BHP reference at the Table-3
-- pump depth 9110 ft.
WELSPECS
   'PROD' 'G1' 11 11 9110 'OIL' /
/

-- Completed in layers 7 and 8 (Table 3), 0.5 ft wellbore diameter, zero skin.
-- The connection transmissibility factor (item 8) is supplied explicitly:
-- the central cell is exactly the wellbore footprint (dx = dy = 2*rw), so
-- Peaceman's equivalent radius r_o = 0.198*dx = 0.099 ft falls inside rw and
-- the geometric well index is undefined.  The parent radial values are used
-- instead, T = 2*pi*0.001127*Kh / (ln(r1/rw) + skin) with r1 = 0.8416 ft:
--   layer 7: Kh = 6200 md-ft -> T = 36.17
--   layer 8: Kh =  480 md-ft -> T = 2.80
-- so the Cartesian well reproduces the SPE-2 productivity index exactly.
COMPDAT
   'PROD' 11 11 7 7 'OPEN' 1* 36.17 0.5 1* 0 /
   'PROD' 11 11 8 8 'OPEN' 1* 2.80  0.5 1* 0 /
/

-- Numerical controls only: start from a 1e-4 day step so the logarithmic
-- early-time reports are resolved, and cap the internal step at 5 days.
TUNING
   0.0001 5.0 /
   /
   /

-- Single fixed oil rate of 1000 STB/D for the whole 900 days, with the
-- Table-3 100 psi minimum BHFP retained as a safety constraint.
WCONPROD
   'PROD' 'OPEN' 'ORAT' 1000 4* 100 /
/

-- 254 report steps: logarithmic over day 1, then 0.5 d to day 10,
-- 2 d to day 100 and 5 d to day 900.
TSTEP
