SCHEDULE
-- ---------------------------------------------------------------------

-- Central producer in column (I,J) = (13,13); BHP reference at the Table-3
-- pump depth 9110 ft.
WELSPECS
   'PROD' 'G1' 13 13 9110 'OIL' /
/

-- Completed in layers 7 and 8 (Table 3), 0.5 ft wellbore diameter, zero skin.
-- The well cell is 164 ft square, so Peaceman's equivalent radius
-- r_o = 0.198*dx = 32.5 ft lies well outside rw = 0.25 ft; item 8 is
-- defaulted and the simulator computes the factor from the cell's geometry.
COMPDAT
   'PROD' 13 13 7 7 'OPEN' 1* 1* 0.5 1* 0 /
   'PROD' 13 13 8 8 'OPEN' 1* 1* 0.5 1* 0 /
/

-- Numerical controls only: start from a 1e-4 day step so the early reports are
-- resolved, and cap the internal step at 5 days.
TUNING
   0.0001 5.0 /
   /
   /

-- One oil-rate target of 1500 STB/D for the whole 900 days, with a
-- 100 psia minimum BHP.
WCONPROD
   'PROD' 'OPEN' 'ORAT' 1500 4* 100 /
/

-- 323 report steps: 100 geometric steps over day 1, then 0.5 d to day 10,
-- 2 d to day 100 and 5 d to day 900.
TSTEP
